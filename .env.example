# ---------------------------------------------------------------------------
# Commute — environment configuration
#
# Copy this file to `.env` and fill in real values. Every variable is validated
# at startup by src/config/env.ts; if one is missing or malformed the app logs a
# human-readable error naming the offending variable and exits (it does NOT boot
# in a half-configured state). Anything marked (required) must be set.
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------

# Postgres connection string. Must be a valid postgres:// URL.
# In docker-compose this points at the bundled `db` service.
# Example (compose): postgres://commute:commute@db:5432/commute
# Example (local):   postgres://commute:commute@localhost:5432/commute
DATABASE_URL=postgres://commute:commute@localhost:5432/commute

# The full external URL this app is served at, scheme + host (+ port if not 80/443).
# Used to build OAuth redirect URIs and to detect Host-header mismatch (a common
# and brutal-to-diagnose cause of silent OAuth callback failures). NO trailing slash.
# Must be HTTPS in production; http://localhost is allowed for local dev.
# Example: https://commute.example.com
APP_URL=http://localhost:3000

# Secret used to sign sessions/cookies. OPTIONAL: if unset, the app generates
# one on first boot and persists it in the database (so losing this var never
# breaks logins). Set it only to control the value explicitly; must then be at
# least 32 characters. Generate one with:  openssl rand -base64 48
# SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Server ----------------------------------------------------------------

# Port the Node server listens on inside the container. Default 3000.
PORT=3000

# IANA timezone the schedule is rendered in (e.g. America/New_York).
# All timestamps are stored in UTC; this only affects display and recurrence
# expansion. A wrong value here makes lectures appear to drift across DST.
DEFAULT_TIMEZONE=America/New_York

# --- First-boot bootstrap (optional escape hatches) ------------------------
# On a genuinely empty database the app auto-creates a settings row and makes
# the first registered account an admin. These override that flow if you need
# a deterministic admin without using the signup form.

# If set, an account with this email is guaranteed admin on boot.
# ADMIN_EMAIL=you@example.com

# One-time token that lets you promote/claim the admin account out-of-band.
# Leave unset unless you specifically need it.
# BOOTSTRAP_TOKEN=

# --- Google (Phase 6 — not required for Phases 1–5) ------------------------
# Leave blank until you reach the Google Calendar integration phase. See
# SETUP_GOOGLE.md. The connection-diagnostics page reports whether these are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Travel provider (Phase 4–5) -------------------------------------------
# Which TravelProvider to use: "fixed" (no API key, hand-entered matrix) or
# "google" (Google Routes API). Defaults to "fixed" so the app works with zero
# API keys out of the box.
TRAVEL_PROVIDER=fixed

# Google Routes API key (only when TRAVEL_PROVIDER=google). Cost control lives
# in in-app settings, not here.
# GOOGLE_ROUTES_API_KEY=
