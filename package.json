{
  "name": "commute",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, location-aware auto-scheduling calendar PWA",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ops": "esbuild src/server/startup.ts src/db/migrate.ts src/cli/promote-admin.ts --bundle --platform=node --format=cjs --target=node22 --external:pg-native --external:cloudflare:sockets --outdir=dist --out-extension:.js=.cjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "startup": "tsx src/server/startup.ts",
    "promote-admin": "tsx src/cli/promote-admin.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "luxon": "3.7.2",
    "next": "16.3.3",
    "pg": "8.23.0",
    "pg-boss": "12.28.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/luxon": "3.7.5",
    "@types/node": "22.10.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@eslint/eslintrc": "3.2.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.26",
    "esbuild": "0.28.2"
  }
}
